# Server-only values. Copy to .env.local and configure these in your hosting platform.
RESEND_API_KEY=
# A sender address on a domain verified in Resend (pelicanmigration.com):
ENQUIRY_FROM_EMAIL=Pelican Immigration <info@pelicanmigration.com>
ENQUIRY_TO_EMAIL=support@pelicanmigration.com
# Optional canonical origin for reverse proxies, e.g. https://www.example.com
SITE_ORIGIN=

# HTTPS endpoint that accepts newsletter subscriptions (see docs/INTEGRATIONS.md).
NEWSLETTER_WEBHOOK_URL=
# Optional bearer token checked by the receiving webhook.
NEWSLETTER_WEBHOOK_SECRET=

# Sanity CMS (server-side published content)
SANITY_PROJECT_ID=3zrn3yuo
SANITY_DATASET=production
# Only needed for a private dataset; leave blank for this public dataset.
SANITY_API_READ_TOKEN=
# Use the same strong random secret in the Sanity GROQ webhook settings.
SANITY_REVALIDATE_SECRET=
